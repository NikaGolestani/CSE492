<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@android:color/white">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Overlay Style"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <RadioGroup
        android:id="@+id/radio_group_style"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/radio_mist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mist Focus"
            android:textSize="16sp"
            android:paddingVertical="8dp" />

        <RadioButton
            android:id="@+id/radio_blackout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Blackout"
            android:textSize="16sp"
            android:paddingVertical="8dp" />

        <RadioButton
            android:id="@+id/radio_vignette"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vignette Blur"
            android:textSize="16sp"
            android:paddingVertical="8dp" />

        <RadioButton
            android:id="@+id/radio_notebook"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Notebook Glow"
            android:textSize="16sp"
            android:paddingVertical="8dp" />

    </RadioGroup>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginVertical="16dp" />

    <Button
        android:id="@+id/btn_close_sheet"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Done"
        android:backgroundTint="#222222"
        android:textColor="@android:color/white" />

</LinearLayout>
